# Confluence Configuration
# Copy this file to .env and fill in your values

# Confluence base URL (required for publish command)
CONFLUENCE_URL=https://yoursite.atlassian.net

# Personal Access Token (required for publish command)
CONFLUENCE_TOKEN=your_pat_token_here

# Default Confluence space key (optional)
CONFLUENCE_SPACE=DEMO

# Optional settings
# CONFLUENCE_PARENT_ID=123456
