# Confluence Connection Settings
# Diese Umgebungsvariablen können gesetzt werden, um die CLI-Parameter zu überschreiben

# Confluence Base URL
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki

# Personal Access Token
CONFLUENCE_TOKEN=your-personal-access-token-here

# Default Space Key
CONFLUENCE_SPACE=DEMO

# Optional: Jira Base URL for Jira link conversion
JIRA_URL=https://jira.lvm.de/jira
