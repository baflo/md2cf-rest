# PowerShell Environment Variables for md2cf
# Copy this file to .env.ps1 and update with your values
# Load with: . .\.env.ps1

# Confluence Connection Settings
$env:CONFLUENCE_URL = "https://your-domain.atlassian.net/wiki"
$env:CONFLUENCE_TOKEN = "your-personal-access-token-here"

# Optional: Default Space Key
$env:CONFLUENCE_SPACE = "DEMO"

# Optional: Jira Base URL for Jira link conversion
$env:JIRA_URL = "https://jira.lvm.de/jira"
